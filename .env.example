# .env.example — IronClaw-Security
#
# Placeholder template only. Never commit a real .env.
#
# This file documents the host sandbox broker keys. It is NOT a complete app
# template: add the remaining app keys (Supabase, *_API_KEY, Stripe, etc.) to
# your existing .env. Do not overwrite an existing .env with this file.

# -----------------------------------------------------------------------------
# Sandbox broker (required for returns to be allowed)
# -----------------------------------------------------------------------------
# Render build/runtime pin. Use an exact supported 3.12 patch release.
# PYTHON_VERSION=3.12.10
#
# Shared secret between the API container and the sandbox-broker service.
# The broker refuses to start without it, and the API blocks every return with
# broker_unconfigured when it is missing. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Docker Compose loads this file into both services. The broker also requires
# /var/run/docker.sock access and builds the pinned scanner image at startup.
# Build the scanner image once first: python -m sandbox_broker.build_image
SANDBOX_BROKER_TOKEN=replace-with-a-long-random-secret
SANDBOX_BROKER_URL=http://127.0.0.1:8088
SANDBOX_BROKER_STARTUP_GRACE_SECONDS=60

# Optional broker tuning (defaults shown). The bind host must stay loopback.
# SANDBOX_BROKER_BIND_HOST=127.0.0.1
# SANDBOX_BROKER_PORT=8088
# SANDBOX_BROKER_IMAGE=ironclaw-sandbox-scanner:1
# SANDBOX_BROKER_TIMEOUT_SECONDS=30
# SANDBOX_BROKER_MAX_TIMEOUT_SECONDS=60
# SANDBOX_BROKER_MEMORY=1g
# SANDBOX_BROKER_CPUS=1.0
# SANDBOX_BROKER_PIDS_LIMIT=128
# SANDBOX_BROKER_TMPFS_SIZE=64m
# SANDBOX_BROKER_MAX_REQUEST_BYTES=1048576
# SANDBOX_BROKER_MAX_OUTPUT_BYTES=65536
