# .env.example — IronClaw-Security
#
# Placeholder template only. Never commit a real .env.
#
# This file documents the host sandbox broker keys. It is NOT a complete app
# template: add the remaining app keys (Supabase, *_API_KEY, Stripe, etc.) to
# your existing .env. Do not overwrite an existing .env with this file.

# -----------------------------------------------------------------------------
# Host sandbox broker (required for returns to be allowed)
# -----------------------------------------------------------------------------
# Shared secret between the API container and the host broker. The broker
# refuses to start without it, and the API blocks every return with
# broker_unconfigured when it is missing. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The host broker reads its process environment (not this file), so export the
# same value in the shell that starts it: python -m sandbox_broker.main
# Build the scanner image once first: python -m sandbox_broker.build_image
SANDBOX_BROKER_TOKEN=replace-with-a-long-random-secret

# Optional broker tuning (defaults shown). The bind host must stay loopback.
# SANDBOX_BROKER_BIND_HOST=127.0.0.1
# SANDBOX_BROKER_PORT=8088
# SANDBOX_BROKER_IMAGE=ironclaw-sandbox-scanner:1
# SANDBOX_BROKER_TIMEOUT_SECONDS=8
# SANDBOX_BROKER_MAX_TIMEOUT_SECONDS=30
# SANDBOX_BROKER_MEMORY=256m
# SANDBOX_BROKER_CPUS=0.5
# SANDBOX_BROKER_PIDS_LIMIT=64
# SANDBOX_BROKER_TMPFS_SIZE=32m
# SANDBOX_BROKER_MAX_REQUEST_BYTES=1048576
# SANDBOX_BROKER_MAX_OUTPUT_BYTES=65536
