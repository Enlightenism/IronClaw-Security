# =============================================================================
# IronClaw-Security — Environment Configuration
# Copy this file to .env and fill in all required values before starting.
# Keys marked REQUIRED must be set. Keys with defaults are optional overrides.
# =============================================================================


# -----------------------------------------------------------------------------
# Application Identity
# -----------------------------------------------------------------------------

# Human-readable name shown in logs and API responses.
APP_NAME=IronClaw-Security

# Semantic version of the running build.
APP_VERSION=0.1.0

# Runtime environment. Accepts: development | test | staging | production
ENVIRONMENT=development

# Enable FastAPI debug mode. Never set true in production.
DEBUG=false

# Enable Uvicorn hot-reload. Development only.
RELOAD=false

# Optional URL prefix for all API routes (e.g. /api/v1). Leave empty for none.
API_PREFIX=


# -----------------------------------------------------------------------------
# Server Binding  (consumed by startup scripts / docker-compose)
# -----------------------------------------------------------------------------

APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://127.0.0.1:8000

# Target URL for the IronClaw engine (IronClawClient / adapter calls).
ENGINE_BASE_URL=http://127.0.0.1:8000

# Legacy aliases — kept for backward compatibility with older scripts.
IRONCLAW_ENV=development
IRONCLAW_BASE_URL=http://127.0.0.1:8000


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Standard Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Emit structured JSON logs. Set false for human-readable output locally.
STRUCTURED_LOGGING_ENABLED=true


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins for CORS preflight checks.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173


# -----------------------------------------------------------------------------
# Authentication  (set AUTH_REQUIRED=true and at least one key in production)
# -----------------------------------------------------------------------------

# Enforce API key authentication on all protected routes.
AUTH_REQUIRED=false

# General-purpose API key for standard callers.
API_KEY=

# Elevated API key for admin operations.
ADMIN_API_KEY=

# API key issued to trusted platform integrations.
PLATFORM_API_KEY=

# Internal service-to-service key (highest trust level).
INTERNAL_PLATFORM_API_KEY=

# Primary IronClaw identity key (aliases all key slots above if none are set).
IRONCLAW_API_KEY=


# -----------------------------------------------------------------------------
# Auth / JWT  (REQUIRED for session-based auth and signed tokens)
# -----------------------------------------------------------------------------

# Secret used for signing session tokens and internal HMAC operations.
# Must be at least 32 characters. REQUIRED in production.
IRONCLAW_SECRET_KEY=changeme-32-chars-minimum!!!!!

# Secret used for signing JWT access tokens.
# Must be at least 32 characters. REQUIRED in production.
JWT_SECRET=changeme-jwt-32-chars-minimum!!

# HMAC algorithm for JWT signing. Default: HS256.
JWT_ALGORITHM=HS256

# Lifetime of an issued access token in minutes. Default: 30.
ACCESS_TOKEN_EXPIRE_MINUTES=30


# -----------------------------------------------------------------------------
# Auth Edge Function  (Supabase Edge Function for advanced auth flows)
# -----------------------------------------------------------------------------

# Supabase Edge Function path invoked during auth verification.
# Example: IRONCLAW_AUTH_EDGE_FN_PATH=auth/verify
# Leave empty to bypass Edge Function auth (default behaviour).
IRONCLAW_AUTH_EDGE_FN_PATH=

# Per-call timeout in seconds for the Edge Function invocation.
# Default: 10.0  Increase for high-latency deployments.
IRONCLAW_AUTH_EDGE_FN_TIMEOUT_SECONDS=10.0


# -----------------------------------------------------------------------------
# Policy & Verdict Defaults
# -----------------------------------------------------------------------------

# Verdict returned when no rule matches. Accepts: allow | block | quarantine
DEFAULT_SCAN_VERDICT=allow

# Review status assigned to new scan records.
# Accepts: not_required | pending | approved | rejected
DEFAULT_REVIEW_STATUS=not_required


# -----------------------------------------------------------------------------
# Risk Thresholds  (integer 0–100, must satisfy: allow_max < quarantine_min <= block_min)
# -----------------------------------------------------------------------------

# Scores at or below this value are auto-allowed.
RISK_THRESHOLD_ALLOW_MAX=29

# Scores at or above this value are quarantined.
RISK_THRESHOLD_QUARANTINE_MIN=30

# Scores at or above this value are hard-blocked.
RISK_THRESHOLD_BLOCK_MIN=70


# -----------------------------------------------------------------------------
# Scan Feature Flags
# -----------------------------------------------------------------------------

ENABLE_TEXT_SCANNING=true
ENABLE_URL_SCANNING=true
ENABLE_GITHUB_REPO_SCANNING=true
ENABLE_ARCHIVE_SCANNING=true


# -----------------------------------------------------------------------------
# Guard / Execution Control Feature Flags
# -----------------------------------------------------------------------------

ENABLE_GUARD_ACTIONS=true
ENABLE_GUARD_ACTION_POLICY=true
ENABLE_GUARD_ACTION_DECISION=true
ENABLE_QUARANTINE_REVIEW=true


# -----------------------------------------------------------------------------
# Input Size Limits
# -----------------------------------------------------------------------------

# Maximum characters accepted in a text scan payload.
MAX_TEXT_CHARS=100000

# Maximum length of a URL submitted for scanning.
MAX_URL_LENGTH=2048

# Maximum length of an archive file name.
MAX_ARCHIVE_NAME_LENGTH=512

# Maximum length of a GitHub repo URL submitted for scanning.
MAX_REPO_URL_LENGTH=2048


# -----------------------------------------------------------------------------
# Groq  (LLM-assisted analysis)
# -----------------------------------------------------------------------------

# Enable Groq-powered analysis passes. Requires GROQ_API_KEY.
GROQ_ENABLED=false

# REQUIRED when GROQ_ENABLED=true. Obtain from https://console.groq.com
GROQ_API_KEY=

# Groq model identifier to use for inference.
GROQ_MODEL=llama3-8b-8192

# Per-request timeout for Groq API calls in seconds.
GROQ_TIMEOUT_SECONDS=60.0


# -----------------------------------------------------------------------------
# OpenAI  (optional — future / plugin use)
# -----------------------------------------------------------------------------

OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# Supabase  (persistence layer — REQUIRED for full operation)
# -----------------------------------------------------------------------------

# Project URL from the Supabase dashboard (Settings → API).
SUPABASE_URL=

# Service role key (bypasses RLS — keep secret, server-side only).
SUPABASE_SERVICE_ROLE_KEY=

# Anon / public key for client-side or read-only operations.
SUPABASE_ANON_KEY=

# Legacy alias for the service role key consumed by some internal adapters.
# Set to the same value as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_KEY=


# -----------------------------------------------------------------------------
# Persistence Mode
# -----------------------------------------------------------------------------

# Backend used for runtime persistence.
# Accepts: memory | supabase
# Use "memory" for local development and tests; "supabase" for all live deployments.
IRONCLAW_PERSISTENCE_MODE=memory


# -----------------------------------------------------------------------------
# File Storage Paths
# -----------------------------------------------------------------------------

REPORTS_DIR=./data/reports
UPLOADS_DIR=./data/uploads
QUARANTINE_DIR=./data/quarantine
BACKUP_DIR=./data/backups

# Root data directory for sample files and offline fixtures.
DATA_DIR=samples


# -----------------------------------------------------------------------------
# Optional Integrations
# -----------------------------------------------------------------------------

# Redis connection URL for distributed rate-limiting, caching, or task queues.
# Leave empty to disable Redis integration.
# Example: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Sentry DSN for error monitoring and performance tracing.
# Leave empty to disable Sentry.
# Example: SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
SENTRY_DSN=


# -----------------------------------------------------------------------------
# Stripe  (payment processing — REQUIRED for billing features)
# -----------------------------------------------------------------------------

# Backend secret key. Server-side only. NEVER expose to the frontend or commit
# a real value here. Obtain from https://dashboard.stripe.com/apikeys
# REQUIRED for all /payments/* routes and webhook verification.
STRIPE_API_KEY=

# Publishable key. Safe to mirror in frontend/.env as
# REACT_APP_STRIPE_PUBLISHABLE_KEY. Obtain from the same Stripe dashboard page.
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret. Obtained from Stripe Dashboard → Developers → Webhooks
# after registering the endpoint. REQUIRED for /payments/webhook signature
# verification. Leave empty until the endpoint is registered.
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Region & Multi-Region / HA
# -----------------------------------------------------------------------------

# The region this IronClaw instance is deployed in.
# Used by get_active_region() to identify the serving node.
# Accepts: us-east-1 | us-west-2 | eu-west-1 | ap-southeast-1
IRONCLAW_REGION=us-east-1

# Enable high-availability mode. When true, REPLICA_REGIONS must be non-empty.
HA_ENABLED=false

# The canonical primary region. Must match a configured REGION_<CODE>_SUPABASE_URL block below.
PRIMARY_REGION=us-east-1

# Comma-separated list of read-replica region codes.
# Leave empty for single-region deployments.
# Example: REPLICA_REGIONS=us-west-2,eu-west-1
REPLICA_REGIONS=

# Enable automatic failover to a healthy replica when the primary is unreachable.
# Only evaluated when HA_ENABLED=true.
REGION_FAILOVER_ENABLED=false

# Interval in seconds between region health probe cycles.
# Must be >= 1. Default: 30.
REGION_HEALTH_CHECK_INTERVAL_SECONDS=30


# -----------------------------------------------------------------------------
# Per-Region Credentials
# Env var pattern:  REGION_<UPPER_CODE_UNDERSCORED>_<FIELD>
# Where UPPER_CODE_UNDERSCORED replaces hyphens with underscores and uppercases
# the region code — e.g.  us-east-1 → US_EAST_1,  eu-west-1 → EU_WEST_1
#
# Required fields per region (region is skipped if SUPABASE_URL is absent):
#   REGION_<CODE>_SUPABASE_URL              — Supabase project URL
#   REGION_<CODE>_SUPABASE_SERVICE_ROLE_KEY — service role key (server-side only)
#   REGION_<CODE>_SUPABASE_ANON_KEY         — anon / public key
#
# Optional fields per region (defaults shown):
#   REGION_<CODE>_IS_PRIMARY                — true | false  (default: false)
#   REGION_<CODE>_IS_READ_REPLICA           — true | false  (default: false)
#   REGION_<CODE>_WEIGHT                    — integer 1–1000 (default: 100)
#
# A region cannot be both IS_PRIMARY=true and IS_READ_REPLICA=true.
# -----------------------------------------------------------------------------

# --- us-east-1 (primary example) ---
REGION_US_EAST_1_SUPABASE_URL=
REGION_US_EAST_1_SUPABASE_SERVICE_ROLE_KEY=
REGION_US_EAST_1_SUPABASE_ANON_KEY=
REGION_US_EAST_1_IS_PRIMARY=true
REGION_US_EAST_1_IS_READ_REPLICA=false
REGION_US_EAST_1_WEIGHT=100

# --- us-west-2 (replica example) ---
REGION_US_WEST_2_SUPABASE_URL=
REGION_US_WEST_2_SUPABASE_SERVICE_ROLE_KEY=
REGION_US_WEST_2_SUPABASE_ANON_KEY=
REGION_US_WEST_2_IS_PRIMARY=false
REGION_US_WEST_2_IS_READ_REPLICA=true
REGION_US_WEST_2_WEIGHT=100

# --- eu-west-1 (replica example) ---
REGION_EU_WEST_1_SUPABASE_URL=
REGION_EU_WEST_1_SUPABASE_SERVICE_ROLE_KEY=
REGION_EU_WEST_1_SUPABASE_ANON_KEY=
REGION_EU_WEST_1_IS_PRIMARY=false
REGION_EU_WEST_1_IS_READ_REPLICA=true
REGION_EU_WEST_1_WEIGHT=100

# --- ap-southeast-1 (replica example) ---
REGION_AP_SOUTHEAST_1_SUPABASE_URL=
REGION_AP_SOUTHEAST_1_SUPABASE_SERVICE_ROLE_KEY=
REGION_AP_SOUTHEAST_1_SUPABASE_ANON_KEY=
REGION_AP_SOUTHEAST_1_IS_PRIMARY=false
REGION_AP_SOUTHEAST_1_IS_READ_REPLICA=true
REGION_AP_SOUTHEAST_1_WEIGHT=100
