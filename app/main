from __future__ import annotations

from fastapi import Depends, FastAPI

from app.api.action_execute import router as execute_router
from app.api.action_guard import router as guard_router
from app.api.history import router as history_router
from app.api.policy import router as policy_router
from app.api.scan import router as scan_router
from app.core.auth import require_api_key


def create_app() -> FastAPI:
    app = FastAPI(
        title="IronClaw-Security",
        version="1.0.0",
        description="Local-first security scanning API with reviewed verdict handling.",
    )

    @app.get("/")
    def root() -> dict[str, str]:
        return {"status": "ok"}

    @app.get("/health", tags=["system"])
    def health() -> dict[str, str]:
        return {"status": "ok"}

    app.include_router(scan_router, prefix="/scan")
    app.include_router(
        history_router,
        prefix="/history",
        dependencies=[Depends(require_api_key)],
    )
    app.include_router(
        guard_router,
        prefix="/guard",
        dependencies=[Depends(require_api_key)],
    )
    app.include_router(
        execute_router,
        prefix="/guard",
        dependencies=[Depends(require_api_key)],
    )
    app.include_router(
        policy_router,
        prefix="/policy",
        dependencies=[Depends(require_api_key)],
    )

    return app


app = create_app()